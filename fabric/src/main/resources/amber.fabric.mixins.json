{
  "required": true,
  "minVersion": "0.8",
  "package": "com.iamkaf.amber.mixin",
  "refmap": "${mod_id}.refmap.json",
  "compatibilityLevel": "${mixin_compat_fabric}",
  "mixins": [
    "AnimalMixin",
    "BlockItemMixin",
    "BoneMealItemMixin",
    //? if >=1.20.5
    "BuiltInRegistriesMixin",
    "CraftedItemMixin",
    "CraftingPlayerMixin",
    //? if <1.19.3
    "CreativeModeTabAccessor",
    //? if <1.19.3
    "CreativeModeTabMixin",
    "CropBlockMixin",
    //? if >=1.21.6
    "EntityShearMixin",
    "FarmlandBlockMixin",
    "FishingHookMixin",
    //? if >=1.20.5
    "ItemAccessor",
    "ItemEntityMixin",
    "LightningBoltMixin",
    "LivingEntityAfterDamageMixin",
    //? if >=26.2
    "MobShearMixin",
    "PlayerMixin",
    "PlayerShearMixin",
    //? if <1.19.2
    //"ServerEntityInteractionMixin",
    //? if >=1.20.5 && <1.21.6
    //"WolfShearMixin",
    "ServerLevelMixin",
    "ServerPlayerDeathMixin",
    "ShearableMobMixin",
    "ShearsDispenseItemBehaviorMixin",
